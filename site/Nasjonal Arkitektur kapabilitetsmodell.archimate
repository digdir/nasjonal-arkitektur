  <folder name="Implementation &amp; Migration" id="id-a675f44ed3c049e3aa64e4ad754be859" type="implementation_migration">
    <element xsi:type="archimate:WorkPackage" name="Konkret tiltak" id="id-6cb4bed065c44e1b8821c60d4515ef28">
      <documentation>Realiserer endringer som fjerner gap. Dette er konkrete tiltak som har startet eller er planlagt.&#xD;
Tiltaket kan forbedre eller realisere en kapabilitet, men er også avhengig av kapabiliteter som finnes.</documentation>
    </element>
    <element xsi:type="archimate:Gap" name="Gap" id="id-66f38bffcd9f48d796a041a9a292d6ed">
      <documentation>Definerer den spesifikke mangelen (assosiert med analyse av dekningsgrad Nasjonal arkitektur)</documentation>
    </element>
