      <element xsi:type="archimate:Constraint" name="Kapasitet" id="id-24ce59ae322d47ae974cf7b60ab33b45"/>
      <element xsi:type="archimate:Driver" name="Kompetanse" id="id-e1cb605054454e0fa20c4ecab1828949">
        <documentation>Ha riktig kompetanse og sikre samarbeid og samordning er det som er avgjørende for dette arbeidet.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Kompetanse" id="id-a1fdbf1b586e49168f5bd345eb8d5ef8"/>
      <element xsi:type="archimate:Driver" name="Økonomiske rammer" id="id-6094ffdec736482fb3bb50f0e2448f9d"/>
      <element xsi:type="archimate:Constraint" name="Økonomiske rammer" id="id-b52f7c7b4a5142ec9122bea10a0cab04"/>
      <element xsi:type="archimate:Driver" name="Tekniske løsninger og infrastruktur" id="id-f1c6e616a4744bdd92bb4618980a9ff5">
        <documentation>tekniske løsninger og infrastruktur må være mer samkjørt og produktstrategisk i felles retning for et felles økosystem</documentation>
      </element>
