    <folder name="Drivere og begresninger" id="id-1e6fb3388d8d4796995f6aa3caa3c840">
      <element xsi:type="archimate:Driver" name="Andre forhold?" id="id-1785953dbdda41fbaa0b7dbd4861c31c"/>
      <element xsi:type="archimate:Constraint" name="Andre forhold?" id="id-2abff1b661b844539a878fbd5c93871d"/>
      <element xsi:type="archimate:Driver" name="Data (tilgang, kvalitet, standardisering)" id="id-fdd16850a7e14a44aa6eee04e7fb7933"/>
