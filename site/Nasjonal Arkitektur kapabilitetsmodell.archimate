      <element xsi:type="archimate:Driver" name="Juridiske forhold" id="id-6ca699ff68db4d6f826a69ff874fd779">
        <documentation>Et fragmentert og komplisert regelverk knyttet til digital sikkerhet gjør at det er mange aktører som gir råd og veiledning på området. Det er et stort behov for bedre samarbeid og samordning på området, for å bedre situasjonen for virksomhetene som skal forholde seg til regelverkene, rådene og veiledningen.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Juridiske forhold" id="id-cdb5a1fd5f594567996f89eb16ebd020"/>
