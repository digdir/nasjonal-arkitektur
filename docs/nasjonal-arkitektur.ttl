    a archimate:Driver ;
    archimate:identifier "id-fdd16850a7e14a44aa6eee04e7fb7933" ;
    archimate:name "Data (tilgang, kvalitet, standardisering)"@nb .

na:id-f063a8707ed544e19d37cd3202144f95
    a archimate:Constraint ;
    archimate:identifier "id-f063a8707ed544e19d37cd3202144f95" ;
    archimate:name "Data (tilgang, kvalitet, standardisering)"@nb .

na:id-6ca699ff68db4d6f826a69ff874fd779
    a archimate:Driver ;
    archimate:identifier "id-6ca699ff68db4d6f826a69ff874fd779" ;
    archimate:name "Juridiske forhold"@nb ;
    archimate:documentation """Et fragmentert og komplisert regelverk knyttet til digital sikkerhet gjør at det er mange aktører som gir råd og veiledning på området. Det er et stort behov for bedre samarbeid og samordning på området, for å bedre situasjonen for virksomhetene som skal forholde seg til regelverkene, rådene og veiledningen."""@nb .

